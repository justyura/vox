# ===== 第一阶段：编译 =====
FROM golang:1.25 AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/cloud ./04_transcriberService/cmd/cloud

# ===== 第二阶段：运行 =====
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/cloud /cloud

ENTRYPOINT ["/cloud"]
